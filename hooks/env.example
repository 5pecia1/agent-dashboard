# Copy to ~/.config/my-dashboard/env and replace the server URL and ingest token.
# Environment variables override this file. No credentials belong in the repository.
MY_DASHBOARD_URL=http://localhost:8787
MY_DASHBOARD_TOKEN='replace-with-ingest-token'

# Default: do not transmit prompts, responses, questions, or raw tool input.
# Enable only if you want these contents sent to your own server.
MY_DASHBOARD_INCLUDE_CONTENT=0

# Optional stable aliases. If absent, hooks use cwd and the short hostname.
# Use the same aliases consistently to preserve session grouping and window links.
#MY_DASHBOARD_PROJECT_LABEL='example-project'
#MY_DASHBOARD_HOST_LABEL='development-machine'

# Optional queue location; default ~/.local/state/my-dashboard.
#MY_DASHBOARD_STATE_DIR=$HOME/.local/state/my-dashboard
