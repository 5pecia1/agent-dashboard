{
  "name": "@5pecia1/agent-dashboard-server",
  "version": "0.1.0-alpha.4",
  "private": false,
  "type": "module",
  "description": "Composable coding-agent dashboard server for Cloudflare Workers and D1.",
  "files": [
    "dist/",
    "contracts/",
    "migrations/",
    "LICENSE",
    "NOTICE",
    "LICENSES/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts/*": "./contracts/*",
    "./migrations/*": "./migrations/*"
  },
  "scripts": {
    "generate": "node scripts/generate-hooks.mjs",
    "check": "npm run generate && tsc --noEmit",
    "typecheck": "npm run check",
    "test": "npm run generate && vitest run",
    "build": "node scripts/build.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test:upgrade": "node scripts/verify-upgrade.mjs",
    "package:starter": "node scripts/package-starter.mjs",
    "verify:starter": "node scripts/verify-starter.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs"
  },
  "peerDependencies": {
    "hono": "4.13.7"
  },
  "devDependencies": {
    "hono": "4.13.7",
    "typescript": "5.9.3",
    "wrangler": "4.129.0",
    "vitest": "4.1.11",
    "esbuild": "0.28.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260905.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5pecia1/agent-dashboard.git",
    "directory": "server"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
